# --- AUTH MODE -------------------------------------------------------------
# Two ways to provide a CanLII API key:
#
# 1) Bring-your-own-key (BYOK, preferred for hosted / shared deployments):
#    Clients send 'X-CanLII-Token: <key>' on every MCP request.
#    No CANLII_API env var needed in HTTP mode.
#
# 2) Single-tenant fallback (self-hosted only):
#    Set CANLII_API below. Used when no per-request header is supplied.
#    Required for stdio transport.
#
# Apply for a free key: https://www.canlii.org/en/api/

CANLII_API=

# Optional: bearer token gating who may use the hosted MCP itself.
# When set, every HTTP request must send 'Authorization: Bearer <token>'.
# Independent of the CanLII key.
MCP_AUTH_TOKEN=

# HTTP server port (only used with --transport http)
PORT=3000
